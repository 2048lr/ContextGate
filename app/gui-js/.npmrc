# FIX-19：npm 已把 electron_mirror / electron_builder_binaries_mirror 标记为
# 「Unknown project config」，并会在下个大版本停止透传。镜像改由环境变量提供：
#
#   ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/
#   ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/
#
# Windows (PowerShell):  $env:ELECTRON_MIRROR = "https://npmmirror.com/mirrors/electron/"
# bash:                  export ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/
registry=https://registry.npmmirror.com/
