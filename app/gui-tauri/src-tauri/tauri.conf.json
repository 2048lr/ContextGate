{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ContextGate",
  "version": "5.2.8",
  "identifier": "com.contextgate.app",
  "build": {
    "frontendDist": "../src",
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devUrl": ""
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ContextGate",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "decorations": false,
        "transparent": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: asset:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../../resources/*"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
