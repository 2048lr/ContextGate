# ContextGate 配置文件
# 请复制此文件为 config.yaml 并填入您的实际配置

# 当前工作空间 - 正在代理的项目路径
workspace: ""

# 货币配置
currency:
  # 固定货币 (可选: CNY, USD, EUR)，留空则自动检测
  fixed_currency: ""
  # 固定汇率 (可选)，留空则使用默认汇率
  fixed_rate: null
  # 汇率 API (可选)
  exchange_rate_api: ""
  # 默认汇率
  default_rates:
    CNY: 7.2
    EUR: 0.92

# 多后端 API 配置
# base_url 可省略，系统会从 models.dev 目录自动解析
# 只需配置 api_key 和选择要使用的模型
#
# FIX-13：API Key 不再以明文写在这里。
#   - 在 GUI 里填写 Key 时会存进 Electron safeStorage（Windows 走 DPAPI）加密库 secrets.json，
#     配置里只留 api_key_ref: "secret"；历史遗留的明文 Key 会在首次启动时被自动迁走。
#   - 无界面的 CLI（node cli.js serve）无法解密该库，请改用 provider 的标准环境变量
#     （OPENAI_API_KEY / ANTHROPIC_API_KEY / DEEPSEEK_API_KEY ...），代理会自动使用它们。
#
# API Key 处理逻辑：
#   1. 代理配置的 api_key 优先使用（如果不是占位符）
#   2. 如果代理 api_key 为空或是占位符，自动使用客户端传来的 key
#   3. 占位符包括：sk-xxx, sk-your-*, your-*, placeholder, 空字符串等
#   4. 设置 passthrough_auth: true 时，始终优先使用客户端传来的 key
#      （适用于 Cursor、Continue、Cline 等强制要求 API Key 的客户端）
#      注意：passthrough_auth 场景下 Authorization 头被用作上游 Key，
#      本地鉴权必须改用 X-ContextGate-Token 头。
providers:
  # OpenAI 配置
  openai:
    api_key: "your-openai-api-key"
    models:
      - "gpt-4o"
      - "gpt-4o-mini"
      - "gpt-4.1"
  
  # Anthropic 配置
  anthropic:
    api_key: "your-anthropic-api-key"
    models:
      - "claude-sonnet-4-20250514"
      - "claude-haiku-4-5-20251001"
  
  # DeepSeek 配置
  deepseek:
    api_key: "your-deepseek-api-key"
    models:
      - "deepseek-chat"
      - "deepseek-reasoner"

  # 智谱 AI 配置 (自定义供应商)
  # zhipu:
  #   api_key: "your-zhipu-api-key"
  #   base_url: "https://open.bigmodel.cn/api/paas/v4"
  #   models:
  #     - "glm-4"
  #     - "glm-4-flash"

# 默认后端
default_provider: "openai"

# 代理服务器配置
proxy:
  host: "127.0.0.1"
  port: 12306
  sanitize_requests: true
  # 请求体上限。Express 默认 100KB，会让任何"把上下文贴进请求"的调用直接 413。
  # 支持 B/KB/MB/GB 后缀。
  max_body_size: "32mb"
  # 为流式请求注入 stream_options.include_usage，让上游回传 usage。
  # 不注入时流式请求的代币与成本会恒为 0。
  inject_stream_usage: true
  # 本地令牌鉴权与来源校验（DNS rebinding / 本机其他进程）
  auth:
    # 强烈建议保持 true。设为 false 时本机任何进程都能白嫖你的 API Key。
    enabled: true
    # Host 头白名单校验（只接受 127.0.0.1 / localhost / [::1]）
    host_check: true
    # 额外允许的 Host 主机名（例如把代理绑定到局域网地址后需要放行）
    allowed_hosts: []
    # 是否允许客户端用 X-Target-Base-Url 指定转发目标（用于获取模型列表）
    allow_target_base_url: true
  # 代理鉴权令牌。首次启动自动生成，也可在 UI 里查看/复制/重置。
  # 客户端用法：Authorization: Bearer <local_token> 或 X-ContextGate-Token: <local_token>
  local_token: ""

  # ---- FIX-15：大请求体的内存策略 ----
  # 超过阈值（也超过 max_body_size 时先返回 413）的请求不再整体解析进内存，
  # 而是把请求体直接流式透传给上游；代价是这类请求不参与响应缓存与 prompt-cache 注入。
  large_body:
    enabled: true
    # 阈值（字节，支持 1mb 这类写法；测试里也可直接写数字）
    threshold_bytes: 1mb
    # 同时在途的大请求上限，超出的排队
    max_concurrent: 2
    # 队列长度上限；队列满或等待超时返回 429 large_request_busy
    max_queue: 16
    queue_timeout_ms: 30000

  # ---- FIX-07：流式可靠性 ----
  stream:
    # 上游两个 chunk 之间超过该时长即判定为半开连接，代理会中止它并给客户端一个 SSE error 帧。
    idle_timeout_ms: 60000
    # 单条流式请求的总时长上限（毫秒）。0 表示不限。
    total_timeout_ms: 0

  # ---- FIX-08：重试 / 降级 / 熔断 / 限流 ----
  resilience:
    max_retries: 2
    retry_statuses: [429, 500, 502, 503, 504]
    base_delay_ms: 500
    max_delay_ms: 8000
    # 退避带随机抖动，避免所有客户端同时重试（thundering herd）
    jitter: true
    # 尊重上游返回的 Retry-After
    respect_retry_after: true
    # 写请求默认只在「可安全重放」时重试：带上 Idempotency-Key，或上游明确表示未处理（429/503）。
    # 设为 true 会连 500/连接中断也重放，上游可能重复计费。
    retry_non_idempotent: false
    # 同时在飞的上游请求上限，超出的排队；队列满或等待超时返回 503。
    max_concurrency: 32
    max_queue: 64
    queue_timeout_ms: 30000
    # provider 降级链：主 provider 全部重试失败后按顺序尝试后面的 provider
    fallback: {}
    # 熔断：连续失败达到阈值后冷却期内直接快速失败，不再打上游
    circuit_breaker:
      enabled: true
      failure_threshold: 5
      cooldown_ms: 30000

  # ---- FIX-10：Prompt Caching ----
  prompt_cache:
    enabled: true
    # 为 Anthropic 形态的请求（含 /v1/messages 原生透传）自动注入 cache_control 断点
    anthropic_cache_control: true
    # OpenAI 侧不需要注入，但会检查前缀是否稳定（时间戳/UUID 等动态内容会破坏前缀缓存）
    openai_prefix_stability: true
    # 小于该 token 数的前缀不会缓存（OpenAI 官方最小可缓存前缀为 1024）
    min_prefix_tokens: 1024

  # ---- FIX-11：协议兼容 ----
  protocols:
    # 允许原生透传 /v1/messages（Claude Code）、/v1/responses（Codex CLI）、/v1/files、/v1/batches
    native_passthrough: true

# 安全配置
security:
  # 是否允许 provider 用 tls.reject_unauthorized: false 关闭 TLS 证书校验。
  # 默认 false = 即使 provider 这么写也会继续校验证书（避免 Key 被中间人截获）。
  allow_insecure_tls: false
  # 允许交给系统浏览器打开的域名白名单（应用窗口内的其它导航与 window.open 一律拒绝）
  allowed_external_hosts:
    - "github.com"

# 响应缓存配置
cache:
  # 缓存条目 TTL（秒）。0 表示不过期。缓存 key 覆盖全部影响输出的参数。
  ttl_seconds: 3600
  # 落盘：重启后缓存仍可用（默认写在 <数据目录>/cache 下）
  persist: true
  max_entries: 200
  max_memory_mb: 100
  max_disk_mb: 256
  # 单条缓存落盘体积上限（字节），超过则只在内存里存活
  persist_max_entry_bytes: 262144
  # 上下文与缓存 key 的绑定方式：
  #   hash = key 里带上下文 hash（保守，上下文一变旧条目不可复用）
  #   off  = 不绑定。当前版本代理不会把工作区上下文注入请求，用户自己粘贴的上下文已在 messages 里、
  #          已参与指纹，因此关掉绑定可以避免「改一个源文件就全表失效」。
  context_binding: hash

# Token 监控配置
monitor:
  # 预算上限（美元）。0 表示不限制。
  budget_limit: 10.00
  # 使用率达到该百分比时告警
  warning_threshold: 75
  # 使用率达到该百分比时严重告警
  critical_threshold: 90
  # 设为 true 时，达到 budget_limit 后新请求会被拒绝（402），即"到额即拒"
  enforce_budget: false
  db_path: "contextgate.db"
  # FIX-12：requests 明细保留天数（0 = 不清理）。日/月聚合不受影响。
  retention_days: 90
  # FIX-12：请求级脱敏日志（provider/模型/token/费用/耗时/错误摘要；绝不记录 prompt 与请求头）
  request_log:
    enabled: true
    # FIX-17：后端可选 sqlite（默认，可通过 GET /requests 查询与导出）或 jsonl（一行一条，便于采集器 tail）
    format: "sqlite"
    # format=jsonl 时的文件名（相对数据目录；绝对路径亦可）
    file: "requests.jsonl"
    retention_days: 30

# ---- FIX-17：可观测与导出 ----
observability:
  metrics:
    # Prometheus 文本格式指标（/metrics）。端点与其他 API 一样要求本地令牌。
    enabled: true
    path: "/metrics"
  request_export:
    # 允许通过 GET /requests/export?format=csv|json 导出脱敏请求日志
    enabled: true
    max_entries: 5000

# ---- FIX-16：自动更新 ----
updates:
  # 只有打包版本（app.isPackaged）才会真正加载 electron-updater
  enabled: true
  # stable = 只接受正式版；beta = 同时接受预发布版
  channel: "stable"
  # 发现新版本后是否自动下载（默认只提示，由用户点击下载）
  auto_download: false
  # 退出时是否自动安装已下载的更新
  auto_install_on_quit: false
  # 自动检查更新的间隔（小时）；0 表示只在启动后检查一次
  check_interval_hours: 6

# 上下文配置
context:
  output_file: "full_context.txt"
  # 输出格式：markdown | xml
  format: "markdown"
  # Token 预算。0 表示不裁剪（输出全量）。
  max_tokens: 8000
  # 是否按预算裁剪
  enforce_budget: true
  # 预算外文件是否降级为摘要（前 N 行）
  summarize_skipped: true
  summary_lines: 12
  # 文件监视：源码变化后自动按防抖延迟重建上下文
  watch_enabled: true
  debounce_seconds: 1.0
  # 对产物做凭据扫描（命中只告警并记入 manifest，不剔除文件）
  secret_scan: true
  dynamic_enabled: false

# 扫描配置
scanner:
  max_file_size: 1048576
  # 额外忽略模式（与 .gitignore / .contextgateignore 叠加）
  exclude: []
  include_extensions:
    - ".py"
    - ".js"
    - ".ts"
    - ".jsx"
    - ".tsx"
    - ".java"
    - ".go"
    - ".rs"
    - ".c"
    - ".cpp"
    - ".h"
    - ".md"
    - ".txt"
    - ".json"
    - ".yaml"
    - ".yml"
