# ContextGate 配置文件
# 请复制此文件为 config.yaml 并填入您的实际配置

# 当前工作空间 - 正在代理的项目路径
workspace: ""

# 货币配置
currency:
  # 固定货币 (可选: CNY, USD, EUR)，留空则自动检测
  fixed_currency: ""
  # 固定汇率 (可选)，留空则使用默认汇率
  fixed_rate: null
  # 汇率 API (可选)
  exchange_rate_api: ""
  # 默认汇率
  default_rates:
    CNY: 7.2
    EUR: 0.92

# 多后端 API 配置
# base_url 可省略，系统会从 models.dev 目录自动解析
# 只需配置 api_key 和选择要使用的模型
#
# API Key 处理逻辑：
#   1. 代理配置的 api_key 优先使用（如果不是占位符）
#   2. 如果代理 api_key 为空或是占位符，自动使用客户端传来的 key
#   3. 占位符包括：sk-xxx, sk-your-*, your-*, placeholder, 空字符串等
#   4. 设置 passthrough_auth: true 时，始终优先使用客户端传来的 key
#      （适用于 Cursor、Continue、Cline 等强制要求 API Key 的客户端）
providers:
  # OpenAI 配置
  openai:
    api_key: "your-openai-api-key"
    models:
      - "gpt-4o"
      - "gpt-4o-mini"
      - "gpt-4.1"
  
  # Anthropic 配置
  anthropic:
    api_key: "your-anthropic-api-key"
    models:
      - "claude-sonnet-4-20250514"
      - "claude-haiku-4-5-20251001"
  
  # DeepSeek 配置
  deepseek:
    api_key: "your-deepseek-api-key"
    models:
      - "deepseek-chat"
      - "deepseek-reasoner"

  # 智谱 AI 配置 (自定义供应商)
  # zhipu:
  #   api_key: "your-zhipu-api-key"
  #   base_url: "https://open.bigmodel.cn/api/paas/v4"
  #   models:
  #     - "glm-4"
  #     - "glm-4-flash"

# 默认后端
default_provider: "openai"

# 代理服务器配置
proxy:
  host: "127.0.0.1"
  port: 12306
  sanitize_requests: true

# Token 监控配置
monitor:
  budget_limit: 10.00
  warning_threshold: 75
  critical_threshold: 90
  db_path: "contextgate.db"

# 上下文配置
context:
  output_file: "full_context.txt"
  max_tokens: 8000
  watch_enabled: true
  debounce_seconds: 1.0
  dynamic_enabled: false

# 扫描配置
scanner:
  max_file_size: 1048576
  include_extensions:
    - ".py"
    - ".js"
    - ".ts"
    - ".jsx"
    - ".tsx"
    - ".java"
    - ".go"
    - ".rs"
    - ".c"
    - ".cpp"
    - ".h"
    - ".md"
    - ".txt"
    - ".json"
    - ".yaml"
    - ".yml"
